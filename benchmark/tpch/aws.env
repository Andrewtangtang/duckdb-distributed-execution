# S3 settings for AWS: credentials come from the instance role, environment, or AWS profile.
export AWS_REGION="${AWS_REGION:-us-east-1}"
export S3_SETUP_SQL="INSTALL cache_httpfs FROM community;
LOAD cache_httpfs;
INSTALL aws;
LOAD aws;
CREATE OR REPLACE SECRET s3 (TYPE S3, PROVIDER credential_chain, REGION '${AWS_REGION}');"
